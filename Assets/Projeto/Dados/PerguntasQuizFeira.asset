  perguntas:
  - enunciado: "Qual \xE9 a capital do Brasil?"
    alternativas:
    - Rio de Janeiro
    - "Bras\xEDlia"
    - Salvador
    - "S\xE3o Paulo"
    respostaCorreta: 1
    fonte: https://www.gov.br/g20/pt-br/sobre-o-g20/cidades-sede/brasilia-df
  - enunciado: "Qual destes alimentos vendidos na feira \xE9 uma fruta?"
    alternativas:
    - Alface
    - Batata
    - Banana
    - Cenoura
    respostaCorreta: 2
    fonte: https://www.embrapa.br/web/mandioca-e-fruticultura/cultivos/banana
  - enunciado: "Qual \xE9 a moeda oficial usada nas compras em uma feira brasileira?"
    alternativas:
    - Real
    - Euro
    - "D\xF3lar"
    - Peso
    respostaCorreta: 0
    fonte: https://www.bcb.gov.br/controleinflacao/planoreal
