%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36927fc9917bbbf4680f76b86961ad77, type: 3}
  m_Name: Feira_BoasVindas
  m_EditorClassIdentifier: 
  lines:
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Oi! Voc\xEA parece meio perdida. Chegou agora?"
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: Cheguei! Eu sou a Quest. Escolhi o Brasil no mapa e vim parar aqui... ainda
      estou tentando entender como tudo funciona.
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Prazer, Quest! Ent\xE3o seja bem-vinda ao Brasil. Voc\xEA caiu num \xF3timo
      lugar para come\xE7ar."
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: "Eu queria conhecer melhor o pa\xEDs... mas tamb\xE9m estou procurando
      uma forma de continuar minha viagem. Ouvi falar de um portal por aqui."
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Tem sim. S\xF3 que ele n\xE3o abre t\xE3o f\xE1cil. Voc\xEA vai precisar
      conseguir tr\xEAs chaves."
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: "Tr\xEAs chaves?"
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Isso. Existe uma em cada parte da sua jornada: uma na Feira, outra na
      Amaz\xF4nia e outra no Ponto Tur\xEDstico."
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Come\xE7a por aqui mesmo. Procure o Bento. Ele tem um desafio para voc\xEA
      e pode te ajudar a conseguir a primeira chave."
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: E depois?
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Depois siga para a Amaz\xF4nia e para o Ponto Tur\xEDstico. Em cada lugar,
      procure o NPC respons\xE1vel e complete o desafio."
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Quando estiver com as tr\xEAs chaves, \xE9 s\xF3 voltar ao Portal."
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: "Entendi! Ent\xE3o, al\xE9m de encontrar as chaves, vou conhecer um pouco
      mais do Brasil pelo caminho."
  - speaker: 0
    speakerName: Lia
    portrait: {fileID: -2126780831, guid: f2e55194d7667d940ad743892c5b976e, type: 3}
    text: "Exatamente. Boa sorte, Quest! O Bento est\xE1 te esperando."
