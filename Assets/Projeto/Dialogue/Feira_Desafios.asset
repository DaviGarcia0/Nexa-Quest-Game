--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36927fc9917bbbf4680f76b86961ad77, type: 3}
  m_Name: Feira_Desafios
  m_EditorClassIdentifier: 
  lines:
  - speaker: 0
    speakerName: Bento
    portrait: {fileID: 1635053191, guid: 91b7b9e5a5fbd004ea753f915592a31f, type: 3}
    text: Ei, Quest! Preparada para os desafios da Feira Brasileira?
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: Claro! O que eu preciso fazer?
  - speaker: 0
    speakerName: Bento
    portrait: {fileID: 1635053191, guid: 91b7b9e5a5fbd004ea753f915592a31f, type: 3}
    text: 'Aqui temos dois desafios: um Quiz e um Minijogo.'
  - speaker: 0
    speakerName: Bento
    portrait: {fileID: 1635053191, guid: 91b7b9e5a5fbd004ea753f915592a31f, type: 3}
    text: No Minijogo, pegue cinco frutas de cada tipo para ganhar a Chave da Vila.
  - speaker: 1
    speakerName: Quest
    portrait: {fileID: 21300000, guid: ed873595101c55446a12e806a0c9a2e2, type: 3}
    text: Uma das chaves do Portal?
  - speaker: 0
    speakerName: Bento
    portrait: {fileID: 1635053191, guid: 91b7b9e5a5fbd004ea753f915592a31f, type: 3}
    text: "Isso! Voc\xEA vai precisar das tr\xEAs para ativ\xE1-lo."
  - speaker: 0
    speakerName: Bento
    portrait: {fileID: 1635053191, guid: 91b7b9e5a5fbd004ea753f915592a31f, type: 3}
    text: "Escolha por qual desafio quer come\xE7ar!"
